# MongoDB: local docker (replica set) OR Atlas connection string
DATABASE_URL="mongodb://localhost:27017/medminder?replicaSet=rs0&directConnection=true"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated allowed frontend origins; first one is used in email links
APP_URL="http://localhost:3000"
# First admin account (created at startup if missing)
ADMIN_EMAIL="admin@medminder.local"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
# Optional: BullMQ reminder queue. Leave empty to use in-process timers.
REDIS_URL=""
# REQUIRED for real emails (verification, reset, reminders).
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="yourname@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="MedMinder <yourname@gmail.com>"
# Dev only: set true to print emails in the console instead of failing when SMTP is missing
MAIL_CONSOLE=false
# Optional Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC=""
VAPID_PRIVATE=""

